# syntax=docker/dockerfile:1.7

FROM node:22.19.0-alpine AS build

ARG NEXT_PUBLIC_GRAPHQL_URI
ENV NEXT_PUBLIC_GRAPHQL_URI=$NEXT_PUBLIC_GRAPHQL_URI \
    GRAPHQL_URI=$NEXT_PUBLIC_GRAPHQL_URI \
    NODE_ENV=production

WORKDIR /app
COPY package.json yarn.lock ./
COPY patches ./patches
RUN yarn install --frozen-lockfile --production=false

COPY . .
RUN yarn build

FROM node:22.19.0-alpine AS runtime

ENV HOSTNAME=0.0.0.0 \
    NODE_ENV=production \
    PORT=3000

RUN addgroup --system --gid 10001 dofuslab \
    && adduser --system --uid 10001 --ingroup dofuslab dofuslab

WORKDIR /app
COPY --from=build --chown=dofuslab:dofuslab /app/node_modules ./node_modules
COPY --from=build --chown=dofuslab:dofuslab /app/.next ./.next
COPY --from=build --chown=dofuslab:dofuslab /app/public ./public
COPY --from=build --chown=dofuslab:dofuslab /app/package.json ./package.json
COPY --from=build --chown=dofuslab:dofuslab /app/next.config.ts ./next.config.ts
COPY --from=build --chown=dofuslab:dofuslab /app/next-i18next.config.js ./next-i18next.config.js

USER 10001:10001
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/ || exit 1

CMD ["node_modules/.bin/next", "start", "-p", "3000"]
