# Protected operational settings. Install this file with mode 0640 and do not
# print or commit the production copy when it contains connection credentials.
DOFUSLAB_SERVER_DIR=/opt/dofuslab/server
PYTHON_BIN=/opt/dofuslab/server/.venv/bin/python

# REQUIRED: supply real values here or source them from a root/service-readable
# environment file. The wrapper fails before Python starts if any are absent.
# DATABASE_URL=postgresql://...
# REDIS_HOST=...
# REDIS_PORT=6379

# Train from builds modified in this many days.
RECOMMENDATION_DAYS=180

# One attempt only: terminate after four hours. The Redis overlap lock lives
# one additional hour so a forced termination cannot immediately overlap.
RECOMMENDATION_MAX_SECONDS=14400
RECOMMENDATION_LOCK_SECONDS=18000
# Transaction-local PostgreSQL timeout: 3h30m, leaving 30 minutes for model
# calculation/publication before the four-hour process deadline.
RECOMMENDATION_DB_TIMEOUT_MS=12600000
# Keep the prior hash for in-flight readers, then expire it to bound Redis use.
RECOMMENDATION_PREVIOUS_VERSION_TTL_SECONDS=3600
REFRESH_LOCK_FILE=/run/lock/dofuslab-recommendation-refresh.lock
